# ─── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API → URL
NEXT_PUBLIC_SUPABASE_URL=https://nwepwncpxcudfypgcyjr.supabase.co

# Dashboard → Settings → API → anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Dashboard → Settings → API → service_role key (NEVER expose to client)
# Used by server-side harvesters and admin operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Optional: Override defaults ──────────────────────────────────────────────
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# ─── Norway Harvester (NAV Arbeidsplassen) ────────────────────────────────────
# Stable token: Register at nav.team.arbeidsplassen@nav.no
# Without this, the harvester falls back to the public rotating token
# (fetched from https://pam-stilling-feed.nav.no/api/publicToken)
# NAV_FEED_TOKEN=your-nav-bearer-token-here
