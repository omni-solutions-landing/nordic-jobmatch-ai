# ─────────────────────────────────────────────────────────────────────────────
# Nordic JobMatch AI — Environment Variables
# Copy to .env.local and fill in. Never commit .env.local.
# Vercel: add all of these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: Supabase (eu-north-1) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, bypasses RLS. Used by GDPR account deletion
# (auth user removal) and the harvest pipeline. NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── REQUIRED: Google Gemini ──────────────────────────────────────────────────
# Used for CV parsing (gemini-2.5-flash), match explanations, keyword
# translation, and embeddings.
GEMINI_API_KEY=your-gemini-api-key

# ── REQUIRED: Cron / Harvest protection ──────────────────────────────────────
# The /api/cron/harvest endpoint checks this bearer token. Without it the
# endpoint would be callable by anyone. Generate: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string

# ── REQUIRED IN PRODUCTION: Site URL ─────────────────────────────────────────
# Used for password-reset redirects and notification links.
# Local dev falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OPTIONAL: Email notifications (Resend) ───────────────────────────────────
# Without this, email match notifications are skipped (logged, not sent).
RESEND_API_KEY=

# ── OPTIONAL: Web Push notifications (VAPID) ─────────────────────────────────
# Generate a pair: npx web-push generate-vapid-keys
# Without these, push notifications are disabled.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── OPTIONAL: Jooble harvester ───────────────────────────────────────────────
# Free partner API key from https://jooble.org/api/about.
# Without it, the Jooble harvester is skipped (logged, not an error).
# NOTE: the key has a request budget (~500) — the harvester makes exactly one
# request per Nordic country per run (4 total). Our key is scoped to the main
# jooble.org endpoint; country subdomains (se.jooble.org, …) reject it.
JOOBLE_API_KEY=

# ── OPTIONAL: Facebook group harvester ───────────────────────────────────────
# Without these, the Facebook harvester is skipped.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GROUP_IDS=

# ── OPTIONAL: Embedding model override ───────────────────────────────────────
# Default: gemini-embedding-001 (768-d via outputDimensionality).
# NOTE: text-embedding-004 was retired by Google on 2026-01-14 — do not use it.
# Changing models requires regenerating ALL stored embeddings.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── DEV ONLY: Mock data fallbacks ────────────────────────────────────────────
# When "true", harvesters return fake job listings if a real fetch fails.
# Useful for local UI work without network access.
# NEVER set this in production — fake jobs would be stored and matched.
# ALLOW_MOCK_FALLBACKS=true
